[Unit]
Description=Task Tracker Web Application
After=syslog.target network.target remote-fs.target nss-lookup.target mariadb.service

[Service]
Type=notify
User=app
Group=app
WorkingDirectory=/opt/mywebapp
ExecStartPre=/opt/mywebapp/migrate.py --host=127.0.0.1 --user=app --password=app --database=task_tracker
ExecStart=/usr/bin/python3 /opt/mywebapp/app.py --host=127.0.0.1 --port=3000 --db-host=127.0.0.1 --db-user=app --db-password=app --db-name=task_tracker
Restart=on-failure
RestartSec=5

# Socket activation
ListenStream=127.0.0.1:3000

[Install]
WantedBy=multi-user.target

